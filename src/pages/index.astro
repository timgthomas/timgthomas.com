---
import Layout from '../components/layout.astro'
import StructuredData from '../components/structured-data.astro'
import { getPosts } from '../lib/models/post'
import { formatDate } from '../lib/utils/datetime'

const [post, nextPost] = await getPosts()
const { Content: RenderedPost } = await post.render()
const description = `Read “${post.data.title},” a post by Tim G Thomas.`
---

<Layout title={post.data.title} {description} type="article">
  <div role="main">
    <article>
      <header>
        <h1>{post.data.title}</h1>
        <p>{formatDate(post.date)}</p>
      </header>
      <RenderedPost />
      <StructuredData {post} {description} />
    </article>
    <nav aria-label="Post navigation">
      <span class="post-nav-prev"></span>
      <span class="post-nav-next">
        {
          nextPost && (
            <a href={nextPost.url}>
              <span class="visually-hidden">Older post: </span>
              {nextPost.data.title}
            </a>
          )
        }
      </span>
    </nav>
    <p class="all-posts"><a href="/archives">Browse all posts</a></p>
  </div>
</Layout>
