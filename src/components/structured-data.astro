---
const { post, description } = Astro.props
const site = Astro.site ?? new URL('https://timgthomas.com')
const url = new URL(post.url, site).href
const image = new URL('/images/headshot.png', site).href

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': url,
  url,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': url,
  },
  headline: post.data.title,
  description,
  datePublished: post.date.toISOString(),
  image,
  author: {
    '@type': 'Person',
    name: 'Tim G Thomas',
    url: site.href,
  },
  publisher: {
    '@type': 'Person',
    name: 'Tim G Thomas',
    url: site.href,
  },
}
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
