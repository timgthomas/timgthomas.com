---
const { post } = Astro.props
---

<nav aria-label="Post navigation">
  <span class="post-nav-prev">
    {
      post.nextPost && (
        <a href={post.nextPost.url}>
          <span class="visually-hidden">Newer post: </span>
          {post.nextPost.data.title}
        </a>
      )
    }
  </span>
  <span class="post-nav-next">
    {
      post.prevPost && (
        <a href={post.prevPost.url}>
          <span class="visually-hidden">Older post: </span>
          {post.prevPost.data.title}
        </a>
      )
    }
  </span>
</nav>
